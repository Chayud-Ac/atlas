# Copy to .env for `npm run dev -w @atlas/api`. Local-only values; .env is git-ignored.
ATLAS_ENV=local
LOG_LEVEL=debug
PORT=3000
OIDC_ISSUER=http://localhost:8090/atlas
OIDC_AUDIENCE=atlas-api
REQUIRED_SCOPE=access_as_user
DB_AUTH=password
DATABASE_URL=postgres://atlas_app:atlas_app@localhost:5432/atlas
