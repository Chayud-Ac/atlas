{
  "name": "@atlas/api",
  "version": "0.0.0",
  "private": true,
  "description": "Atlas Express API",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build ../../packages/shared && tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsc --build ../../packages/shared && tsx --env-file=.env.migrate src/migrate.ts",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@atlas/shared": "*",
    "@azure/identity": "^4.13.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
