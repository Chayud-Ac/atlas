# shellcheck shell=sh
# Runs at container start. The nginx image *sources* files ending in .envsh (it runs .sh
# files), so AUTH_ORIGIN exported here reaches 20-envsubst-on-templates.sh, which renders
# /etc/nginx/templates. The 19- prefix makes this run just before it.

# Stop the container from starting, instead of serving a broken /config.json.
: "${ATLAS_ENV:?must be set}"
: "${AUTH_KIND:?must be set}"
: "${AUTH_AUTHORITY:?must be set}"
: "${AUTH_CLIENT_ID:?must be set}"
: "${AUTH_API_SCOPE:?must be set}"
: "${API_UPSTREAM:?must be set}"

# The browser fetches tokens from the sign-in server, so the CSP must allow its origin:
# https://login.microsoftonline.com/<tenant> gives https://login.microsoftonline.com
AUTH_ORIGIN=$(printf '%s' "$AUTH_AUTHORITY" | sed -E 's#^(https?://[^/]+).*#\1#')
export AUTH_ORIGIN

# Optional: without it (locally) the app sends no telemetry. It's written into JSON and into the
# CSP header, so only the characters a connection string uses are allowed. Exported even when
# empty: envsubst leaves an unset variable's ${NAME} in the file.
APPLICATIONINSIGHTS_CONNECTION_STRING="${APPLICATIONINSIGHTS_CONNECTION_STRING:-}"
case "$APPLICATIONINSIGHTS_CONNECTION_STRING" in
  *[!A-Za-z0-9=\;:/._-]*)
    echo "APPLICATIONINSIGHTS_CONNECTION_STRING contains unexpected characters" >&2
    exit 1
    ;;
esac
export APPLICATIONINSIGHTS_CONNECTION_STRING

# The browser SDK posts to the connection string's IngestionEndpoint, so the CSP must allow its
# origin: ...;IngestionEndpoint=https://japaneast-1.in.applicationinsights.azure.com/;... gives
# https://japaneast-1.in.applicationinsights.azure.com
TELEMETRY_ORIGIN=$(printf '%s' "$APPLICATIONINSIGHTS_CONNECTION_STRING" |
  sed -n -E 's#.*IngestionEndpoint=(https?://[^/;]+).*#\1#p')
export TELEMETRY_ORIGIN
