{
  "name": "atlas",
  "version": "0.0.0",
  "private": true,
  "description": "Scaffold for internal company apps on Azure",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.4"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint:format": "prettier --check .",
    "lint:ts": "eslint --max-warnings=0 .",
    "lint": "npm run lint:ts && npm run lint:format && npm run lint:gh && npm run lint:sh",
    "typecheck": "tsc --build",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @atlas/e2e",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:integration",
    "prepare": "husky",
    "lint:gh": "actionlint",
    "lint:sh": "shellcheck scripts/*.sh apps/web/nginx/*.envsh"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write",
    "scripts/*.sh": "shellcheck",
    "apps/web/nginx/*.envsh": "shellcheck"
  }
}
