{
  "name": "atlas",
  "version": "0.0.0",
  "private": true,
  "description": "Scaffold for internal company apps on Azure",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint:format": "prettier --check .",
    "lint:ts": "eslint --max-warnings=0 .",
    "lint": "npm run lint:ts && npm run lint:format"
  }
}
